<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <title>駝背偵測（整合版）</title>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.10.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/pose-detection"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-detection"></script>
    <style>
      body {
        margin: 0;
        background: black;
        color: white;
        text-align: center;
        font-family: "Microsoft JhengHei", sans-serif;
      }
      h1 {
        margin-top: 12px;
      }
      #output {
        width: 480px;
        height: 360px;
        display: block;
        margin: 8px auto;
        border: 2px solid white;
        background: #000;
      }
      #controls {
        margin: 10px;
      }
      button {
        margin: 5px;
        padding: 8px 16px;
        font-size: 14px;
        cursor: pointer;
        background: #333;
        color: #fff;
        border: 1px solid #666;
        border-radius: 4px;
      }
      button:hover {
        background: #555;
      }
      input,
      select {
        padding: 6px;
        margin: 5px;
        font-size: 14px;
        background: #222;
        color: #fff;
        border: 1px solid #666;
        border-radius: 4px;
      }
      #chartSection {
        background: #111;
        padding: 10px;
        margin: 12px auto;
        width: 98%;
        max-width: 1400px;
        border-radius: 6px;
        border: 1px solid #333;
      }
      #chartActions {
        margin-bottom: 8px;
      }
      #chartContainer {
        width: 100%;
        min-width: 320px;
        max-width: 1400px;
        height: 430px;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid #666;
        background: #000;
        white-space: nowrap;
        margin-top: 5px;
        padding: 10px 0 30px 0;
        position: relative;
      }
      /* 新增提示樣式 */
      .chart-tooltip {
        position: absolute;
        background: #222;
        color: #fff;
        padding: 6px 8px;
        border-radius: 4px;
        font-size: 12px;
        border: 1px solid #666;
        pointer-events: none;
        transform: translate(-50%, -120%);
        white-space: nowrap;
        z-index: 10;
      }
      #chartCanvas {
        display: inline-block;
        background: transparent;
        min-width: 320px;
        vertical-align: top;
      }
      #statsBox {
        margin-top: 10px;
        background: #0f0f0f;
        color: #fff;
        padding: 8px;
        border-radius: 6px;
        text-align: left;
        display: inline-block;
      }
      #statsBox div {
        margin: 4px 0;
      }
      #rawArea {
        background: #111;
        color: #0f0;
        padding: 10px;
        margin: 10px auto;
        width: 90%;
        max-width: 800px;
        border: 1px solid #333;
        border-radius: 4px;
        max-height: 200px;
        overflow-y: auto;
        font-family: monospace;
        font-size: 11px;
      }
    </style>
  </head>
  <body>
    <h1>駝背偵測（整合 BLE / USB）</h1>

    <div id="controls">
      <button id="connectBle">連接 BLE</button>
      <button id="connectUsb">連接 USB</button>
      <button id="disconnectUsb" style="display: none">斷開 USB</button>
      <span id="connectionStatus" style="margin: 0 10px; color: #aaa"
        >狀態: 未連線</span
      >
      <button id="switchCamera" style="margin-left: 20px">切換鏡頭</button>
      <button id="clearChart">清除圖表紀錄</button>
      <button id="downloadCsv">下載紀錄 (record.csv)</button>
      <label
        ><input type="checkbox" id="showLandmarks" checked /> 顯示
        landmarks</label
      >
      <label
        ><input type="checkbox" id="showSpine" checked /> 顯示 脊椎線</label
      >
      <label
        >平滑 α (0-1):
        <input
          type="number"
          id="smoothingAlpha"
          value="0.3"
          min="0"
          max="1"
          step="0.1"
      /></label>
      <label
        >Debounce 幀數:
        <input type="number" id="debounceFrames" value="5" min="1" max="30"
      /></label>
      <label
        ><input type="checkbox" id="showAllLabels" /> 顯示全部時間標籤</label
      >
      <!-- 新增 -->
      <button id="calibrateBtn" style="border-color: #0af; color: #0af">
        校正標準姿勢
      </button>
      <button id="resetThresholdBtn">重設閾值 (170)</button>
      <span
        id="statusDisplay"
        style="margin-left: 10px; font-weight: bold; color: #fff"
        >角度: --° (閾值: 170°)</span
      >
      <label><input type="checkbox" id="enableAudio" /> 音效提示</label>
      <span
        id="fpsDisplay"
        style="font-size: 12px; color: #ff0; margin-left: 5px"
        >FPS: 0</span
      >
    </div>

    <canvas id="output" width="480" height="360"></canvas>

    <div id="rawArea">-- 自動診斷信息 --</div>

    <div id="chartSection">
      <div id="chartContainer">
        <canvas id="chartCanvas"></canvas>
        <!-- 新增：提示元素 -->
        <div
          id="chartTooltip"
          class="chart-tooltip"
          style="display: none"
        ></div>
      </div>

      <div id="statsBox">
        <div>🟥 駝背次數： <span id="badCount">0</span></div>
        <div>🟩 正常次數： <span id="goodCount">0</span></div>
        <div>📈 總紀錄： <span id="totalCount">0</span></div>
        <div>📊 駝背比例： <span id="badRatio">0%</span></div>
      </div>
    </div>

    <script>
      // ================== 全局變數 ==================
      // postureLog: 儲存姿勢紀錄的陣列，用於繪製圖表
      let postureLog = [];
      // isSlouching: 當前的姿勢狀態 (true: 駝背, false: 正常)，由 debounce 穩定後的值
      let isSlouching = false;
      // detector: MoveNet 姿勢偵測模型實例
      // canvas, ctx, video: HTML 畫布與影片元素相關物件
      let detector, canvas, ctx, video;
      // useFrontCamera: 控制使用前置或後置鏡頭
      let useFrontCamera = true;
      // currentThreshold: 判斷駝背的角度閾值 (小於此值視為駝背)
      let currentThreshold = 170; // 改為 170 度
      // poses: 儲存偵測到的姿勢數據
      let poses = [];
      // lastAngle: 儲存最後一次計算的角度，用於校正功能
      let lastAngle = 180;
      // videoStream: 保存攝影機的媒體串流物件，方便管理
      let videoStream = null; // 新增：保存串流物件

      // --- EMA (指數移動平均) + Debounce (防抖動) 參數 ---
      // slouchEMA: 用於平滑化原始偵測結果的變數
      let slouchEMA = 0.5;
      // SMOOTHING_ALPHA_DEFAULT: EMA 平滑化的 alpha 值，值越小越平滑
      const SMOOTHING_ALPHA_DEFAULT = 0.3;
      // DEBOUNCE_FRAMES_DEFAULT: 狀態改變需要持續的幀數，防止瞬間切換
      const DEBOUNCE_FRAMES_DEFAULT = 5;
      // debounceCounter: 防抖動計數器
      let debounceCounter = 0;
      // smoothingAlpha, debounceFrames: 可由 UI 控制的當前參數值
      let smoothingAlpha = SMOOTHING_ALPHA_DEFAULT;
      let debounceFrames = DEBOUNCE_FRAMES_DEFAULT;

      // --- 偵測參數 ---
      // MIN_KP_SCORE: 接受的關鍵點最低信心分數，過濾掉不準確的點
      const MIN_KP_SCORE = 0.25; // 降低至 0.25
      // _lastRawMsgTime: 用於限制診斷訊息更新頻率的時間戳
      let _lastRawMsgTime = 0; // 限頻診斷訊息（毫秒）
      // _lastFpsTime, _frameCount: 用於計算 FPS
      let _lastFpsTime = 0;
      let _frameCount = 0;
      // 新增：用於每秒更新角度顯示的變數
      let _lastAngleUpdateTime = 0;
      let _latestCalculatedAngle = NaN;

      // --- BLE / USB 通訊 ---
      // BLE
      let bleDevice, ledMatrixCharacteristic;
      const circlePattern = new Uint8Array([0x0e, 0x11, 0x11, 0x11, 0x0e]); // ⭕
      const crossPattern = new Uint8Array([0x11, 0x0a, 0x04, 0x0a, 0x11]); // ❌

      // USB (Web Serial)
      let port, writer;
      let isWriting = false; // 防止重複寫入

      // ================== 初始化攝影機 ==================
      /**
       * 初始化並啟動攝影機。
       * 包含停止舊串流、請求新串流、設定 video 元素、錯誤處理與自動重試。
       */
      async function initCamera() {
        // 如果已有攝影機串流，先停止它
        if (videoStream) {
          videoStream.getTracks().forEach((track) => track.stop());
          videoStream = null;
        }

        video = document.createElement("video");
        video.autoplay = true;
        video.playsInline = true; // 在 iOS 上內聯播放
        video.muted = true; // 靜音以允許自動播放
        video.width = 640;
        video.height = 480;

        // 設定攝影機約束條件 (前/後鏡頭, 解析度)
        const constraints = {
          video: {
            facingMode: useFrontCamera ? "user" : "environment",
            width: { ideal: 640 },
            height: { ideal: 480 },
          },
          audio: false,
        };

        try {
          console.log("📡 正在請求攝影機權限...");
          videoStream = await navigator.mediaDevices.getUserMedia(constraints);
          console.log("✅ 取得攝影機串流");

          video.srcObject = videoStream; // 將串流指派給 video 元素

          // 改善 onloadedmetadata 監聽
          await new Promise((resolve, reject) => {
            const timeout = setTimeout(() => {
              reject(new Error("攝影機初始化逾時"));
            }, 5000);

            video.onloadedmetadata = () => {
              clearTimeout(timeout);
              console.log("✅ 攝影機元資料已加載");
              resolve();
            };

            video.play().catch((err) => {
              clearTimeout(timeout);
              reject(err);
            });
          });

          canvas = document.getElementById("output");
          canvas.width = 480;
          canvas.height = 360;
          ctx = canvas.getContext("2d");
          console.log(
            "📐 攝影機啟動成功",
            video.videoWidth,
            "x",
            video.videoHeight,
          );
        } catch (err) {
          // 攝影機啟動失敗的詳細錯誤處理
          console.error("❌ 攝影機錯誤詳情：", err.name, err.message);

          let errorMsg = "無法啟動攝影機。\n\n";
          if (err.name === "NotAllowedError") {
            errorMsg += "❌ 權限被拒絕：請在瀏覽器設定中允許攝影機權限";
          } else if (err.name === "NotFoundError") {
            errorMsg += "❌ 找不到攝影機：請檢查是否有連接攝影機";
          } else if (err.name === "NotReadableError") {
            errorMsg += "❌ 攝影機被佔用：請關閉其他使用攝影機的程式";
          } else {
            errorMsg += `❌ 錯誤：${err.message}`;
          }

          errorMsg += "\n\n10秒後自動重試...";
          alert(errorMsg);
          console.log("🔄 將在 10 秒後重試");
          setTimeout(initCamera, 10000);
        }
      }

      // 綁定 "切換鏡頭" 按鈕事件
      document
        .getElementById("switchCamera")
        .addEventListener("click", async () => {
          useFrontCamera = !useFrontCamera;
          console.log("🔄 切換鏡頭:", useFrontCamera ? "前置" : "後置");
          await initCamera();
        });

      // ================== 工具函數 ==================
      /**
       * 計算三點構成的角度
       * @param {object} a - 點 A {x, y}
       * @param {object} b - 頂點 B {x, y}
       * @param {object} c - 點 C {x, y}
       * @returns {number} - 角度 (0-180)
       */
      function getAngle(a, b, c) {
        const ab = { x: a.x - b.x, y: a.y - b.y };
        const cb = { x: c.x - b.x, y: c.y - b.y };
        const dot = ab.x * cb.x + ab.y * cb.y;
        const abLen = Math.hypot(ab.x, ab.y);
        const cbLen = Math.hypot(cb.x, cb.y);
        return Math.acos(dot / (abLen * cbLen)) * (180 / Math.PI);
      }

      /**
       * 將模型輸出的座標點 (通常在影像原始尺寸或 0-1 範圍內) 縮放到畫布尺寸
       * @param {object|array} pt - 座標點
       * @param {HTMLVideoElement} video - 影片元素
       * @param {HTMLCanvasElement} canvas - 畫布元素
       * @returns {object} - 縮放後的座標 {x, y}
       */
      function scalePoint(pt, video, canvas) {
        if (!pt || !canvas) return { x: 0, y: 0 };
        let x = null,
          y = null;
        if (Array.isArray(pt) && pt.length >= 2) {
          x = Number(pt[0]);
          y = Number(pt[1]);
        } else if (typeof pt.x !== "undefined" && typeof pt.y !== "undefined") {
          x = Number(pt.x);
          y = Number(pt.y);
        } else if (
          typeof pt[0] !== "undefined" &&
          typeof pt[1] !== "undefined"
        ) {
          x = Number(pt[0]);
          y = Number(pt[1]);
        }
        if (isNaN(x) || isNaN(y)) return { x: 0, y: 0 };

        // 如果座標是 0-1 的正規化格式
        if (x >= 0 && x <= 1 && y >= 0 && y <= 1) {
          const cx = x * canvas.width;
          const cy = y * canvas.height;
          return { x: cx, y: cy };
        }

        // 如果座標是基於影像原始尺寸
        const vw = video && video.videoWidth ? video.videoWidth : 640;
        const vh = video && video.videoHeight ? video.videoHeight : 480;
        const rx = vw > 0 ? (x * canvas.width) / vw : x;
        const ry = vh > 0 ? (y * canvas.height) / vh : y;
        return { x: rx, y: ry };
      }

      // ================== 繪製函數（縮小點的大小） ==================
      /**
       * 在畫布上繪製 MoveNet 偵測到的所有關鍵點
       * @param {array} kps - 關鍵點陣列
       */
      function drawMoveNetKeypoints(kps) {
        if (!document.getElementById("showLandmarks").checked) return;

        // 根據駝背狀態決定顏色 (isSlouching 是全域變數)
        const pointColor = isSlouching ? "red" : "lime";

        // 定義偵測邏輯需要的關鍵點名稱
        const essentialKeypoints = new Set([
          "nose",
          "left_eye",
          "right_eye",
          "left_ear",
          "right_ear",
          "left_shoulder",
          "right_shoulder",
          "left_hip",
          "right_hip",
        ]);

        kps.forEach((kp) => {
          // 只繪製偵測需要的關鍵點
          if (essentialKeypoints.has(kp.name) && kp.score > MIN_KP_SCORE) {
            const pt = scalePoint(kp, video, canvas);
            ctx.fillStyle = pointColor;
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, 3, 0, 2 * Math.PI);
            ctx.fill();
          }
        });
      }

      /**
       * 繪製臉部關鍵點 (此處已停用)
       * @param {array} faces - 臉部偵測結果
       */
      function drawFaceLandmarks(faces) {
        // 移除臉部偵測
        return;
      }

      /**
       * 在畫布上繪製從肩膀中心到臀部中心的脊椎線
       * @param {array} poses - 姿勢偵測結果
       */
      function drawSpineLine(poses) {
        if (!document.getElementById("showSpine").checked || poses.length === 0)
          return;
        const kps = {};
        poses[0].keypoints.forEach((kp) => {
          kps[kp.name] = kp;
        });

        if (
          kps["left_shoulder"] &&
          kps["right_shoulder"] &&
          kps["left_hip"] &&
          kps["right_hip"]
        ) {
          const shoulder = scalePoint(
            {
              x: (kps["left_shoulder"].x + kps["right_shoulder"].x) / 2,
              y: (kps["left_shoulder"].y + kps["right_shoulder"].y) / 2,
            },
            video,
            canvas,
          );
          const hip = scalePoint(
            {
              x: (kps["left_hip"].x + kps["right_hip"].x) / 2,
              y: (kps["left_hip"].y + kps["right_hip"].y) / 2,
            },
            video,
            canvas,
          );

          ctx.strokeStyle = isSlouching ? "red" : "lime";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(shoulder.x, shoulder.y);
          ctx.lineTo(hip.x, hip.y);
          ctx.stroke();
        }
      }

      // --- 時間格式化與文字繪製工具 ---
      function pad(n, width = 2) {
        return String(n).padStart(width, "0");
      }

      // 格式化時間為 HH:MM:SS
      function formatTime(dateLike) {
        const d = dateLike instanceof Date ? dateLike : new Date(dateLike);
        return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
      }

      /**
       * 在畫布上繪製直排文字
       * @param {CanvasRenderingContext2D} ctx - 畫布上下文
       * @param {string} text - 要繪製的文字
       */
      function drawVerticalText(ctx, text, x, yTop, lineHeight = 12) {
        // 保留原字型/樣式，僅設置對齊
        const prevAlign = ctx.textAlign;
        const prevBaseline = ctx.textBaseline;
        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        for (let i = 0; i < text.length; i++) {
          ctx.fillText(text[i], x, yTop + i * lineHeight);
        }
        ctx.textAlign = prevAlign;
        ctx.textBaseline = prevBaseline;
      }

      /**
       * 顯示診斷訊息到 #rawArea 區域，每秒最多更新一次以避免畫面閃爍。
       * @param {string} msg - 要顯示的訊息
       */
      function showRawMsg(msg) {
        const now = Date.now();
        if (now - _lastRawMsgTime < 1000) return; // 1s 限頻
        _lastRawMsgTime = now;
        const el = document.getElementById("rawArea");
        if (!el) return;
        el.textContent = `-- 自動診斷信息 --\n${msg}`;
      }

      /**
       * 根據可用的關鍵點，智能地選擇一個點來代表 "頭部後方" 的位置，用於計算角度。
       * 優先順序：雙耳中心 > 雙眼中心 > 單耳/單眼 > 鼻子 > 肩膀估算
       * @param {object} kps - 關鍵點物件
       */
      function getHeadBackCandidate(kps) {
        const safe = (kp) =>
          kp && (typeof kp.score === "undefined" || kp.score >= MIN_KP_SCORE);

        // 優先用雙耳（最準確）
        if (safe(kps["left_ear"]) && safe(kps["right_ear"])) {
          return {
            x: (kps["left_ear"].x + kps["right_ear"].x) / 2,
            y: (kps["left_ear"].y + kps["right_ear"].y) / 2,
            source: "ears",
          };
        }

        // 次優用雙眼
        if (safe(kps["left_eye"]) && safe(kps["right_eye"])) {
          return {
            x: (kps["left_eye"].x + kps["right_eye"].x) / 2,
            y: (kps["left_eye"].y + kps["right_eye"].y) / 2,
            source: "eyes",
          };
        }

        // 允許單耳或單眼（容錯）
        if (safe(kps["left_ear"])) {
          return {
            x: kps["left_ear"].x,
            y: kps["left_ear"].y,
            source: "left_ear",
          };
        }
        if (safe(kps["right_ear"])) {
          return {
            x: kps["right_ear"].x,
            y: kps["right_ear"].y,
            source: "right_ear",
          };
        }
        if (safe(kps["left_eye"])) {
          return {
            x: kps["left_eye"].x,
            y: kps["left_eye"].y,
            source: "left_eye",
          };
        }
        if (safe(kps["right_eye"])) {
          return {
            x: kps["right_eye"].x,
            y: kps["right_eye"].y,
            source: "right_eye",
          };
        }

        // 鼻子
        if (safe(kps["nose"])) {
          return { x: kps["nose"].x, y: kps["nose"].y, source: "nose" };
        }

        // 若以上都沒有，根據肩膀和臀部位置估算一個頭部位置
        if (
          safe(kps["left_shoulder"]) &&
          safe(kps["right_shoulder"]) &&
          safe(kps["left_hip"]) &&
          safe(kps["right_hip"])
        ) {
          const shoulderX =
            (kps["left_shoulder"].x + kps["right_shoulder"].x) / 2;
          const shoulderY =
            (kps["left_shoulder"].y + kps["right_shoulder"].y) / 2;
          const hipY = (kps["left_hip"].y + kps["right_hip"].y) / 2;
          const torsoHeight = Math.max(1e-3, hipY - shoulderY);
          const estY = shoulderY - 0.15 * torsoHeight;
          return { x: shoulderX, y: estY, source: "est_shoulder" };
        }

        return null;
      }

      // ================== 主渲染迴圈 ==================
      /**
       * 每一幀都會執行的主要函式。包含繪製影像、姿勢偵測、邏輯判斷、繪製結果等。
       */
      async function renderPose() {
        // 防呆：如果 video, ctx 或 detector 尚未準備好，就先不執行，等待下一幀
        if (!video || !ctx || !detector) {
          return requestAnimationFrame(renderPose);
        }

        // --- 計算 FPS ---
        _frameCount++;
        const now = performance.now();
        if (now - _lastFpsTime >= 1000) {
          document.getElementById("fpsDisplay").innerText =
            `FPS: ${_frameCount}`;
          _frameCount = 0;
          _lastFpsTime = now;
        }

        // --- 每秒更新一次角度顯示 ---
        if (now - _lastAngleUpdateTime >= 1000) {
          const angleText = isNaN(_latestCalculatedAngle)
            ? "--"
            : _latestCalculatedAngle.toFixed(1);
          document.getElementById("statusDisplay").innerText =
            `角度: ${angleText}° (閾值: ${currentThreshold}°)`;
          _lastAngleUpdateTime = now;
        }

        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

        // 使用 MoveNet 模型進行姿勢偵測
        poses = await detector.estimatePoses(video);
        if (poses.length > 0) {
          drawMoveNetKeypoints(poses[0].keypoints);
          drawSpineLine(poses);

          const kps = {};
          poses[0].keypoints.forEach((kp) => {
            kps[kp.name] = kp;
          });

          // ================== 混合判斷邏輯：角度 + 眼耳相對位置 ==================
          let slouchRaw = 0; // 原始的駝背判斷結果 (1:駝背, 0:正常)
          let angle = NaN;
          let isSlouchingByAngle = false;
          let isSlouchingByHeadTilt = false;
          let diagnosticMsg = "";

          const safe = (kp) => kp && kp.score >= MIN_KP_SCORE;

          // --- 1. 身體角度判斷 ---
          if (
            safe(kps["left_shoulder"]) &&
            safe(kps["right_shoulder"]) &&
            safe(kps["left_hip"]) &&
            safe(kps["right_hip"])
          ) {
            const headCand = getHeadBackCandidate(kps);
            if (headCand) {
              const headBack = scalePoint(headCand, video, canvas);
              const shoulderCenter = scalePoint(
                {
                  x: (kps["left_shoulder"].x + kps["right_shoulder"].x) / 2,
                  y: (kps["left_shoulder"].y + kps["right_shoulder"].y) / 2,
                },
                video,
                canvas,
              );
              const hip = scalePoint(
                {
                  x: (kps["left_hip"].x + kps["right_hip"].x) / 2,
                  y: (kps["left_hip"].y + kps["right_hip"].y) / 2,
                },
                video,
                canvas,
              );

              angle = getAngle(headBack, shoulderCenter, hip);
              if (!isNaN(angle)) {
                lastAngle = angle; // 更新全域變數，供校正按鈕使用
                _latestCalculatedAngle = angle; // 儲存最新計算出的角度
              }
              isSlouchingByAngle = angle < currentThreshold;
              diagnosticMsg += `角度: ${angle.toFixed(1)}° (${isSlouchingByAngle ? "駝背" : "正常"})。`;
            } else {
              diagnosticMsg += "角度判斷失敗(無頭部點)。";
              _latestCalculatedAngle = NaN; // 若偵測失敗，重置角度
            }
          } else {
            diagnosticMsg += "角度判斷失敗(無肩/臀點)。";
            _latestCalculatedAngle = NaN; // 若偵測失敗，重置角度
          }

          // --- 2. 頭部傾斜 (眼耳相對位置) 判斷 ---
          if (
            safe(kps["left_eye"]) &&
            safe(kps["right_eye"]) &&
            safe(kps["left_ear"]) &&
            safe(kps["right_ear"])
          ) {
            const eyeCenterY = (kps["left_eye"].y + kps["right_eye"].y) / 2;
            const earCenterY = (kps["left_ear"].y + kps["right_ear"].y) / 2;
            isSlouchingByHeadTilt = eyeCenterY > earCenterY;
            diagnosticMsg += `\n眼耳判斷: ${isSlouchingByHeadTilt ? "駝背" : "正常"} (眼Y:${eyeCenterY.toFixed(1)}, 耳Y:${earCenterY.toFixed(1)})。`;
          } else {
            diagnosticMsg += "\n眼耳判斷失敗(缺少關鍵點)。";
          }

          // --- 3. 組合判斷結果 ---
          // 只要任一條件成立，就判定為駝背
          if (isSlouchingByAngle || isSlouchingByHeadTilt) {
            slouchRaw = 1;
          }

          showRawMsg(diagnosticMsg);

          // --- 平滑化與防抖動處理 ---
          // 1. 使用 EMA 平滑化原始結果
          slouchEMA =
            slouchRaw * smoothingAlpha + slouchEMA * (1 - smoothingAlpha);
          const potentialState = slouchEMA > 0.5; // true 或 false

          // 2. 如果平滑後的結果與當前穩定狀態不同，增加防抖計數器
          if (potentialState !== isSlouching) debounceCounter++;
          else debounceCounter = 0;

          // 3. 只有當計數器達到閾值時，才真正改變穩定狀態，並觸發硬體通知
          if (debounceCounter >= debounceFrames) {
            isSlouching = potentialState;
            debounceCounter = 0;
            console.log(`姿勢狀態改變: ${isSlouching ? "駝背" : "正常"}`);
            updateDeviceStatus(isSlouching); // 觸發硬體通知
            // --- 音效提示 ---
            if (isSlouching && document.getElementById("enableAudio").checked) {
              playBeep();
            }
          }

          // --- 在畫布上繪製結果 ---
          ctx.fillStyle = isSlouching ? "#ff0000" : "#00ff00";
          ctx.font = "32px Arial";
          ctx.fillText(isSlouching ? "❌ 駝背" : "✅ 正常", 20, 40);

          ctx.fillStyle = "#ffffff";
          ctx.font = "16px Arial";
          ctx.fillText(
            `角度: ${isNaN(angle) ? "N/A" : angle.toFixed(1) + "°"} (閾值: ${currentThreshold}°)`,
            20,
            canvas.height - 20,
          );
        } // 結束 if(poses.length > 0)
        // 請求瀏覽器在下一次重繪前再次呼叫 renderPose，形成動畫迴圈
        requestAnimationFrame(renderPose);
      }

      // ================== UI 控制 ==================
      // 綁定各個控制項的事件監聽
      document
        .getElementById("showLandmarks")
        .addEventListener("change", () => {});
      document.getElementById("showSpine").addEventListener("change", () => {});
      document
        .getElementById("smoothingAlpha")
        .addEventListener("change", (e) => {
          smoothingAlpha = parseFloat(e.target.value);
        });
      document
        .getElementById("debounceFrames")
        .addEventListener("change", (e) => {
          debounceFrames = parseInt(e.target.value);
        });

      // "顯示全部時間標籤" 的 checkbox，改變時立即重繪圖表
      document
        .getElementById("showAllLabels")
        .addEventListener("change", () => {
          drawChart();
        });

      // --- 新增：校正按鈕事件 ---
      document.getElementById("calibrateBtn").addEventListener("click", () => {
        if (lastAngle && !isNaN(lastAngle)) {
          // 設定閾值為當前角度減去 10 度 (容許範圍)
          const newThreshold = Math.floor(lastAngle - 10);
          // 避免閾值過低或過高 (限制在 100~175 之間)
          currentThreshold = Math.max(100, Math.min(175, newThreshold));
          alert(
            `✅ 校正完成！\n偵測到目前角度：${lastAngle.toFixed(1)}°\n已設定新閾值：${currentThreshold}° (容許 10° 緩衝)`,
          );
        } else {
          alert("❌ 無法取得當前角度，請確保全身入鏡並保持姿勢。");
        }
      });

      document
        .getElementById("resetThresholdBtn")
        .addEventListener("click", () => {
          currentThreshold = 170;
          alert("✅ 閾值已重設為 170°");
        });

      // --- 新增：播放音效函數 ---
      function playBeep() {
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const ctx = new AudioContext();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.type = "sine";
          osc.frequency.value = 440; // A4 音高
          gain.gain.setValueAtTime(0.1, ctx.currentTime); // 音量 0.1
          osc.start();
          osc.stop(ctx.currentTime + 0.3); // 嗶 0.3 秒
        } catch (e) {
          console.error("Audio play failed", e);
        }
      }

      // ================== BLE / USB 通訊 ==================
      const connectionStatusEl = document.getElementById("connectionStatus");
      const connectBleBtn = document.getElementById("connectBle");
      const connectUsbBtn = document.getElementById("connectUsb");
      const disconnectUsbBtn = document.getElementById("disconnectUsb");

      // --- BLE (藍牙) ---
      const LED_SERVICE_UUID = "e95dd91d-251d-470a-a062-fa1922dfa9a8";
      const LED_MATRIX_CHAR_UUID = "e95d7b77-251d-470a-a062-fa1922dfa9a8";

      function onBleDisconnected() {
        console.log("BLE 裝置已斷線");
        if (connectionStatusEl.textContent.includes("BLE")) {
          connectionStatusEl.textContent = "狀態: 未連線";
          connectionStatusEl.style.color = "#aaa";
        }
        ledMatrixCharacteristic = null;
        bleDevice = null;
        connectBleBtn.disabled = false;
      }

      async function connectBle() {
        try {
          console.log("正在請求 BLE 裝置...");
          connectionStatusEl.textContent = "狀態: 正在請求裝置...";
          bleDevice = await navigator.bluetooth.requestDevice({
            filters: [{ namePrefix: "BBC micro:bit" }],
            optionalServices: [LED_SERVICE_UUID],
          });

          bleDevice.addEventListener(
            "gattserverdisconnected",
            onBleDisconnected,
          );

          console.log("正在連接到 GATT 伺服器...");
          connectionStatusEl.textContent = "狀態: 正在連線...";
          const server = await bleDevice.gatt.connect();
          const service = await server.getPrimaryService(LED_SERVICE_UUID);
          ledMatrixCharacteristic =
            await service.getCharacteristic(LED_MATRIX_CHAR_UUID);

          console.log("✅ micro:bit (BLE) 已連接");
          connectionStatusEl.textContent = "狀態: BLE 已連線";
          connectionStatusEl.style.color = "#4caf50";
          connectBleBtn.disabled = true;
          updateDeviceStatus(isSlouching); // 連線成功後立即更新一次狀態
        } catch (err) {
          console.error("❌ BLE 連線失敗：", err);
          connectionStatusEl.textContent = "狀態: BLE 連線失敗";
          connectionStatusEl.style.color = "#f44336";
          alert("BLE 連線失敗: " + err.message);
          onBleDisconnected(); // 清理狀態
        }
      }

      // --- USB (序列埠) ---
      async function connectSerial() {
        try {
          if (port && port.readable) {
            alert("✅ USB 已經連線中！");
            return;
          }
          console.log("正在請求序列埠...");
          connectionStatusEl.textContent = "狀態: 請求序列埠...";
          port = await navigator.serial.requestPort();
          await port.open({ baudRate: 115200 });
          writer = port.writable.getWriter();

          console.log("🔌 micro:bit (USB) 已連線！");
          connectionStatusEl.textContent = "狀態: USB 已連線";
          connectionStatusEl.style.color = "#4caf50";
          connectUsbBtn.style.display = "none";
          disconnectUsbBtn.style.display = "inline-block";
          updateDeviceStatus(isSlouching); // 連線成功後立即更新一次狀態
        } catch (err) {
          console.error("❌ USB 連線失敗：", err);
          connectionStatusEl.textContent = "狀態: USB 連線失敗";
          connectionStatusEl.style.color = "#f44336";
          alert("USB 連線失敗：" + err.message);
        }
      }

      async function disconnectSerial() {
        try {
          if (writer) {
            await writer.close();
            writer = null;
          }
          if (port) {
            await port.close();
            port = null;
          }
          console.log("🔌 USB 已斷開連線");
          connectionStatusEl.textContent = "狀態: 未連線";
          connectionStatusEl.style.color = "#aaa";
          connectUsbBtn.style.display = "inline-block";
          disconnectUsbBtn.style.display = "none";
        } catch (err) {
          console.error("❌ USB 斷線失敗：", err);
          alert("USB 斷線失敗：" + err);
        }
      }

      async function sendToSerial(data) {
        if (!writer || isWriting) return;
        try {
          isWriting = true;
          const encoder = new TextEncoder();
          await writer.write(encoder.encode(data + "\n"));
          console.log(`📤 USB Sent: ${data}`);
        } catch (err) {
          console.error("USB 傳送錯誤：", err);
          await disconnectSerial();
        } finally {
          isWriting = false;
        }
      }

      // --- 統一的狀態更新函數 ---
      async function updateDeviceStatus(slouching) {
        if (ledMatrixCharacteristic) {
          try {
            await ledMatrixCharacteristic.writeValue(
              slouching ? crossPattern : circlePattern,
            );
            console.log(`📤 BLE Sent: ${slouching ? "❌" : "⭕"}`);
          } catch (err) {
            console.error("BLE 傳送失敗:", err);
            if (err.name === "NetworkError") onBleDisconnected();
          }
        }
        if (writer) {
          await sendToSerial(slouching ? "1" : "0");
        }
      }

      // ================== 圖表 ==================
      const chartCanvas = document.getElementById("chartCanvas");
      const chartCtx = chartCanvas.getContext("2d");
      const chartContainerEl = document.getElementById("chartContainer");
      const chartTooltipEl = document.getElementById("chartTooltip");

      /**
       * 根據紀錄數量和容器寬度，動態更新圖表畫布的寬度和高度。
       */
      function updateChartCanvasSize() {
        const parentWidth = chartCanvas.parentElement.offsetWidth || 320;
        const spacing = 5;
        const bw = 20;
        const totalWidth = postureLog.length * (bw + spacing);
        chartCanvas.width = Math.max(parentWidth, totalWidth, 320);
        chartCanvas.style.width = chartCanvas.width + "px";

        // 動態計算額外空間以容納直排標籤
        const showAll = document.getElementById("showAllLabels").checked;
        const maxRows = showAll ? 6 : 1;
        const rowSpacing = 14;
        const labelExtraSpace = showAll ? 12 + maxRows * rowSpacing : 70;

        // 根據 labelExtraSpace 調整 canvas 高度，確保標籤不會被裁切
        const baseHeight = 260;
        chartCanvas.height = Math.max(410, baseHeight + labelExtraSpace);
        chartCanvas.style.height = chartCanvas.height + "px";
      }

      function barWidth() {
        return 20;
      }

      /**
       * 繪製整個姿勢紀錄圖表。
       * 包含背景格線、長條圖、時間標籤等。
       */
      function drawChart() {
        updateChartCanvasSize();
        chartCtx.fillStyle = "#000";
        chartCtx.fillRect(0, 0, chartCanvas.width, chartCanvas.height);

        const spacing = 5,
          canvasHeight = chartCanvas.height;
        const showAll = document.getElementById("showAllLabels").checked;

        // 計算繪製長條圖和標籤所需的空間
        const maxRows = 6;
        const rowSpacing = 14;
        const labelExtraSpace = showAll ? 12 + maxRows * rowSpacing : 70;
        const bw = barWidth();
        const barMaxHeight = canvasHeight - (labelExtraSpace + 60);

        // 繪製背景格線
        chartCtx.strokeStyle = "#444";
        chartCtx.lineWidth = 1;
        for (let x = 0; x <= chartCanvas.width; x += 20) {
          chartCtx.beginPath();
          chartCtx.moveTo(x + 0.5, 0);
          chartCtx.lineTo(x + 0.5, canvasHeight);
          chartCtx.stroke();
        }
        for (let y = 0; y <= canvasHeight; y += 20) {
          chartCtx.beginPath();
          chartCtx.moveTo(0, y + 0.5);
          chartCtx.lineTo(chartCanvas.width, y + 0.5);
          chartCtx.stroke();
        }

        // 計算時間標籤的顯示間隔，避免過於擁擠
        const maxLabels = 8;
        const labelInterval = showAll
          ? 1
          : Math.max(1, Math.ceil(postureLog.length / maxLabels));

        // 當 showAll 時，維護每列最後一個標籤的 X 位置以避免重疊
        const lastXByRow = new Array(maxRows).fill(-1e9);
        let lastLabel = null;
        let duplicateCount = 0;

        // 遍歷所有紀錄並繪製
        postureLog.forEach((entry, i) => {
          const x = i * (bw + spacing) + bw / 2;
          chartCtx.fillStyle = entry.status === 1 ? "red" : "lime";
          chartCtx.fillRect(x - bw / 2, 0, bw, barMaxHeight);

          // 根據設定決定是否顯示時間標籤
          if (
            showAll ||
            i % labelInterval === 0 ||
            i === postureLog.length - 1
          ) {
            if (showAll) {
              chartCtx.save();
              chartCtx.translate(x, barMaxHeight + 8);
              chartCtx.font = "8px Arial";
              chartCtx.fillStyle = "#ccc";

              // 處理連續相同的時間標籤，附加後綴以區分
              const baseLabel = entry.time || "";
              let labelToShow = baseLabel;
              if (labelToShow === lastLabel) {
                duplicateCount++;
                labelToShow = `${labelToShow}·${duplicateCount}`;
              } else {
                duplicateCount = 0;
              }
              lastLabel = labelToShow;

              const textWidth = chartCtx.measureText(labelToShow).width;
              // 尋找一個不會與前一個標籤重疊的行來放置標籤
              let placedRow = 0;
              for (let r = 0; r < maxRows; r++) {
                const margin = 6;
                if (
                  x - lastXByRow[r] >= textWidth / 2 + margin ||
                  lastXByRow[r] < 0
                ) {
                  placedRow = r;
                  break;
                }
              }
              // 計算直排文字的高度並確保不會超出畫布
              const lineHeight = 12;
              const textHeight = labelToShow.length * lineHeight;
              const availableHeight = chartCanvas.height - (barMaxHeight + 8); // 可用給標籤的高度
              let yOff = placedRow * rowSpacing;
              if (yOff + textHeight > availableHeight) {
                // 調整 yOff 讓文字完全顯示（往上擠）
                yOff = Math.max(0, availableHeight - textHeight);
              }

              lastXByRow[placedRow] = x + textWidth / 2;
              drawVerticalText(chartCtx, labelToShow, 0, yOff, lineHeight);
              chartCtx.restore();
            } else {
              // 非 "showAll" 模式：直排顯示在長條圖下方
              chartCtx.save();
              chartCtx.translate(x, barMaxHeight + 8);
              chartCtx.font = "9px Arial";
              chartCtx.fillStyle = "#ccc";

              const baseLabel = entry.time || "";
              let labelToShow = baseLabel;
              if (labelToShow === lastLabel) {
                duplicateCount++;
                labelToShow = `${labelToShow}·${duplicateCount}`;
              } else {
                duplicateCount = 0;
              }
              lastLabel = labelToShow;

              // 如果直排文字高度超出可用空間，則縮小行高以完整顯示
              const lineHeight = 12;
              const textHeight = labelToShow.length * lineHeight;
              const availableHeight = chartCanvas.height - (barMaxHeight + 8);
              let effectiveLineHeight = lineHeight;
              if (textHeight > availableHeight) {
                effectiveLineHeight = Math.max(
                  8,
                  Math.floor(availableHeight / labelToShow.length),
                );
              }
              drawVerticalText(
                chartCtx,
                labelToShow,
                0,
                0,
                effectiveLineHeight,
              );
              chartCtx.restore();
            }
          }
        });

        // 更新統計數據
        updateStats();
      }

      /**
       * 更新統計數據框中的數字 (駝背次數、比例等)
       */
      function updateStats() {
        const badCount = postureLog.filter((e) => e.status === 1).length;
        const goodCount = postureLog.filter((e) => e.status === 0).length;
        const total = postureLog.length;
        const ratio = total === 0 ? 0 : Math.round((badCount / total) * 100);
        document.getElementById("badCount").innerText = badCount;
        document.getElementById("goodCount").innerText = goodCount;
        document.getElementById("totalCount").innerText = total;
        document.getElementById("badRatio").innerText = ratio + "%";
      }

      // "清除圖表紀錄" 按鈕事件
      document.getElementById("clearChart").addEventListener("click", () => {
        postureLog = [];
        drawChart();
      });

      /**
       * 將姿勢紀錄轉換為 CSV 格式並觸發下載。
       */
      document.getElementById("downloadCsv").addEventListener("click", () => {
        let csv = "時間,時間_ISO,狀態\n";
        postureLog.forEach((row) => {
          const iso = row.timeISO ? row.timeISO : "";
          csv += `${row.time},${iso},${row.status === 1 ? "駝背" : "正常"}\n`;
        });
        const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "record.csv";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      // --- 圖表互動 (滑鼠/觸控提示) ---
      /**
       * 根據滑鼠或觸控事件的座標，計算對應的長條圖索引。
       * @param {MouseEvent|TouchEvent} e - 事件物件
       */
      function getBarIndexFromEvent(e) {
        const rect = chartCanvas.getBoundingClientRect();
        const scaleX = chartCanvas.width / rect.width;
        const spacing = 5;
        const bw = barWidth();
        // 計算相對 canvas 的 X（考慮縮放）
        const xCanvas = (e.clientX - rect.left) * scaleX;
        const idx = Math.floor(xCanvas / (bw + spacing));
        return idx >= 0 && idx < postureLog.length ? idx : -1;
      }

      /**
       * 在滑鼠或觸控位置顯示一個包含詳細資訊的提示框。
       * @param {MouseEvent|TouchEvent} e - 事件物件
       */
      function showChartTooltip(e, entry) {
        if (!entry) {
          chartTooltipEl.style.display = "none";
          return;
        }
        chartTooltipEl.textContent = `${entry.time}  ${entry.status === 1 ? "駝背" : "正常"}`;
        chartTooltipEl.title = entry.timeISO || "";
        chartTooltipEl.style.display = "block";
        const containerRect = chartContainerEl.getBoundingClientRect();
        const left =
          e.clientX - containerRect.left + chartContainerEl.scrollLeft;
        const top =
          e.clientY - containerRect.top + chartContainerEl.scrollTop - 12;
        chartTooltipEl.style.left = left + "px";
        chartTooltipEl.style.top = top + "px";
      }

      // 綁定滑鼠在圖表上移動和離開的事件
      chartCanvas.addEventListener("mousemove", (e) => {
        const idx = getBarIndexFromEvent(e);
        if (idx >= 0) showChartTooltip(e, postureLog[idx]);
        else chartTooltipEl.style.display = "none";
      });
      chartCanvas.addEventListener("mouseleave", () => {
        chartTooltipEl.style.display = "none";
      });

      // 綁定觸控事件，以支援在行動裝置上顯示提示
      chartCanvas.addEventListener("touchmove", (e) => {
        const touch = e.touches[0];
        const fakeEvent = { clientX: touch.clientX, clientY: touch.clientY };
        const idx = getBarIndexFromEvent(fakeEvent);
        if (idx >= 0) showChartTooltip(fakeEvent, postureLog[idx]);
        else chartTooltipEl.style.display = "none";
      });
      chartCanvas.addEventListener("touchend", () => {
        chartTooltipEl.style.display = "none";
      });

      // ================== 定時紀錄 ==================
      // 每 5 秒執行一次，將當前的姿勢狀態加入到紀錄中，並重繪圖表
      setInterval(() => {
        const now = new Date();
        const iso = now.toISOString();
        const label = formatTime(now);
        postureLog.push({
          time: label,
          timeISO: iso,
          status: isSlouching ? 1 : 0,
        });
        drawChart();
      }, 5000);

      // ================== 初始化 ==================
      /**
       * 程式進入點。依序執行攝影機初始化、模型加載、圖表初始化和啟動渲染迴圈。
       */
      async function init() {
        await initCamera();

        // 等待 video 完全準備好
        await new Promise((resolve) => setTimeout(resolve, 500));

        // 載入 MoveNet 模型
        try {
          detector = await poseDetection.createDetector(
            poseDetection.SupportedModels.MoveNet,
            { modelType: poseDetection.movenet.modelType.THUNDER },
          );
          console.log("✅ MoveNet 模型加載成功");
        } catch (err) {
          console.error("❌ MoveNet 加載失敗：", err);
        }

        // 初始繪製一次圖表
        drawChart();
        // 啟動主渲染迴圈
        renderPose();
      }

      // --- 事件綁定 ---
      document
        .getElementById("connectBle")
        .addEventListener("click", connectBle);
      document
        .getElementById("connectUsb")
        .addEventListener("click", connectSerial);
      document
        .getElementById("disconnectUsb")
        .addEventListener("click", disconnectSerial);

      // 頁面關閉前自動清理 USB 連線
      window.addEventListener("beforeunload", async () => {
        await disconnectSerial();
      });

      // 執行初始化函式，並捕捉可能的頂層錯誤
      init().catch((err) => console.error("初始化錯誤：", err));
    </script>
  </body>
</html>
